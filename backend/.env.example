# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Roboflow Configuration (for workflow-based detection)
ROBOFLOW_API_KEY=your-roboflow-api-key
DETECTION_METHOD=yolo  # Options: 'yolo' (local) or 'roboflow' (cloud workflow)

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# JWT Secret (if implementing custom auth)
JWT_SECRET_KEY=your-jwt-secret-key

# Webhook Secrets (for payment verification)
GCASH_WEBHOOK_SECRET=your-gcash-webhook-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# For production on Vercel, set to: https://your-app.vercel.app

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Persist backend passenger-count updates at most once every 30 seconds.
DB_SAVE_INTERVAL=30

# SMS Service API URL (Raspberry Pi)
# Leave empty to enable auto-discovery, or set manually: http://192.168.1.100:8001
SMS_API_URL=

# Raspberry Pi automatically polls the backend for active trips
# No manual configuration needed - Pi polls /api/trips every 10 seconds

# Cloudflare Configuration (for video storage)
# Stream API for video hosting (recommended)
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# R2 Storage for direct file uploads (alternative to Stream)
# Access credentials for S3-compatible API
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=commutai-videos
