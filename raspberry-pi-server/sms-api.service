[Unit]
Description=SMS API Service for Bus Monitoring System
After=network.target
Wants=network.target

[Service]
Type=simple
User=chichi
WorkingDirectory=/home/chichi/sys-admin/raspberry-pi-server
Environment="PATH=/home/chichi/sys-admin/raspberry-pi-server/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/chichi/sys-admin/raspberry-pi-server/venv/bin/python /home/chichi/sys-admin/raspberry-pi-server/sms_api_server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
