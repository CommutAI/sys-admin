[Unit]
Description=Bus Video Monitoring Server (FastAPI)
After=network.target commutai-setup.service
Requires=commutai-setup.service

[Service]
Type=simple
User=chichi
WorkingDirectory=/home/chichi/raspberry-pi-server
Environment="PATH=/home/chichi/raspberry-pi-server/venv/bin:/home/chichi/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/chichi/raspberry-pi-server/.env
ExecStart=/home/chichi/raspberry-pi-server/venv/bin/python /home/chichi/raspberry-pi-server/video_server_fastapi.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
