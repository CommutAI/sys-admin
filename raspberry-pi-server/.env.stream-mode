# Raspberry Pi Stream-Only Mode Configuration
# This configuration disables local AI processing and streams raw frames to backend

# Backend Configuration
# For PRODUCTION: Set to your Render backend URL (HTTPS)
# For LOCAL DEV: Set to your Windows IP address (HTTP)
# Example Production: BACKEND_URL=https://sys-admin-my13.onrender.com
# Example Local: BACKEND_URL=http://192.168.1.100:8000
# Leave commented for auto-discovery on local network (recommended for local dev only)
# BACKEND_URL=https://sys-admin-my13.onrender.com

# Disable local AI processing
DISABLE_AI=true
COUNT_METHOD=none

# Camera Configuration (optimized for 30-60 FPS)
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FPS=30
JPEG_QUALITY=25

# Bus Configuration
BUS_NUMBER=1
PORT=5000

# Supabase Configuration
SUPABASE_URL=https://iyacktzzktwrpeibcena.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml5YWNrdHp6a3R3cnBlaWJjZW5hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEwNzAxMzMsImV4cCI6MjEwNjY0NjEzM30.nnUW_wjKE9t6V_ZNNR1u_HqcqQletGEsJ4A2kcBLxl0

# Hardware Configuration
ENABLE_SMS=false
ENABLE_GPS=true
ENABLE_EMERGENCY_BUTTON=false
ENABLE_GEOLOCATION=true
SIM900A_PORT=/dev/ttyUSB0
SIM900A_BAUDRATE=9600
NEO6M_PORT=/dev/ttyS0
NEO6M_BAUDRATE=9600
EMERGENCY_BUTTON_PIN=18
OSM_USER_AGENT=BusMonitoringSystem
EMERGENCY_CONTACTS=
ADMIN_CONTACTS=

# Cloudflare Stream Configuration (for video storage)
# Note: Cloudflare Stream requires a paid plan or trial activation
# Set to false to store videos locally only
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
