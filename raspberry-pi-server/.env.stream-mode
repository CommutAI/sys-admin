# Raspberry Pi Stream-Only Mode Configuration
# This configuration disables local AI processing and streams raw frames to backend

# Backend Configuration (Windows system)
BACKEND_URL=http://192.168.1.XX:8000
# Replace XX with your Windows system's IP address

# Disable local AI processing
DISABLE_AI=true
COUNT_METHOD=none

# Camera Configuration (optimized for streaming)
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FPS=10
JPEG_QUALITY=60

# Bus Configuration
BUS_NUMBER=1
PORT=5000

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Hardware Configuration
ENABLE_SMS=false
ENABLE_GPS=false
ENABLE_EMERGENCY_BUTTON=false
ENABLE_GEOLOCATION=true
SIM900A_PORT=/dev/ttyS0
SIM900A_BAUDRATE=9600
NEO6M_PORT=/dev/serial0
NEO6M_BAUDRATE=9600
EMERGENCY_BUTTON_PIN=18
OSM_USER_AGENT=BusMonitoringSystem
EMERGENCY_CONTACTS=
ADMIN_CONTACTS=
