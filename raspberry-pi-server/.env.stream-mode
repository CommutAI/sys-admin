# Raspberry Pi Stream-Only Mode Configuration
# This configuration disables local AI processing and streams raw frames to backend

# Backend Configuration (Windows system)
# BACKEND_URL will be auto-discovered on local network (recommended)
# To manually set if auto-discovery fails, uncomment below:
# BACKEND_URL=http://YOUR_WINDOWS_IP:8000

# Disable local AI processing
DISABLE_AI=true
COUNT_METHOD=none

# Camera Configuration (optimized for 30-60 FPS)
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FPS=30
JPEG_QUALITY=25

# Bus Configuration
BUS_NUMBER=1
PORT=5000

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Hardware Configuration
ENABLE_SMS=false
ENABLE_GPS=true
ENABLE_EMERGENCY_BUTTON=false
ENABLE_GEOLOCATION=true
SIM900A_PORT=/dev/ttyUSB0
SIM900A_BAUDRATE=9600
NEO6M_PORT=/dev/ttyS0
NEO6M_BAUDRATE=9600
EMERGENCY_BUTTON_PIN=18
OSM_USER_AGENT=BusMonitoringSystem
EMERGENCY_CONTACTS=
ADMIN_CONTACTS=
