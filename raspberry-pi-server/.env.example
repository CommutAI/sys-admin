# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-anon-key

# Hardware Configuration
# Enable/disable hardware components
ENABLE_SMS=false
ENABLE_GPS=true
ENABLE_EMERGENCY_BUTTON=false
ENABLE_GEOLOCATION=true

# SIM900A GSM Module Configuration
SIM900A_PORT=/dev/ttyS0
SIM900A_BAUDRATE=9600

# NEO-M8L GPS Module Configuration
# Uses u-blox NEO-M8L for high-precision GPS tracking
GPS_PORT=/dev/ttyS0
GPS_BAUDRATE=9600

# Emergency Button Configuration
EMERGENCY_BUTTON_PIN=18

# OpenStreetMap Geolocation Configuration (Free)
# No API key required for basic IP geolocation
OSM_USER_AGENT=BusMonitoringSystem

# Emergency Contacts (comma-separated phone numbers)
EMERGENCY_CONTACTS=+639927268704,+639108945427,

# Admin Contacts (comma-separated phone numbers for alerts)
ADMIN_CONTACTS=+639108945427

# Backend API Configuration
# URL of the FastAPI backend service
# Option 1: Auto-discovery (recommended for production)
# BACKEND_URL=auto  # System will discover backend from Supabase
# Option 2: Manual configuration (for development/testing)
BACKEND_URL=http://localhost:8000

RASPBERRY_PI_URL=http://commutai.local:8000

# AI Detection Configuration
COUNT_METHOD=yolo
DISABLE_AI=false
YOLO_CONFIDENCE_THRESHOLD=0.35
DETECTION_SIZE=320

# Drawing Configuration
# Set to false to show green bounding boxes on detected passengers
# Set to true for maximum performance (no visual annotations)
DISABLE_DRAWING=false

# Performance Settings
ENABLE_REALTIME_MODE=true
SKIP_DETECTION_FRAMES=9
DISABLE_DB_WRITES=false
SKIP_WEBSOCKET_THROTTLE=false
FRAME_QUEUE_SIZE=5

# Video Recording
ENABLE_VIDEO_RECORDING=true
VIDEO_OUTPUT_DIR=./recordings

# Camera Configuration
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FPS=30
JPEG_QUALITY=40

# Enable Camera on Startup
ENABLE_CAMERA=true

# Cloudflare Stream Configuration (for video storage)
# Sign up at https://dash.cloudflare.com/stream
# Get Account ID from dashboard, create API token with Stream permissions
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
