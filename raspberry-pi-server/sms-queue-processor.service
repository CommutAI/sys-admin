[Unit]
Description=SMS Queue Processor for Bus Monitoring System
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/raspberry-pi-server
Environment="PATH=/home/pi/raspberry-pi-server/venv/bin:/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/pi/raspberry-pi-server/.env
ExecStart=/home/pi/raspberry-pi-server/venv/bin/python /home/pi/raspberry-pi-server/sms_queue_processor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
