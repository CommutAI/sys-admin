# Supabase Configuration
SUPABASE_URL=https://eiajnmocwxarymfdabjv.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVpYWpubW9jd3hhcnltZmRhYmp2Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MzkwODI1MywiZXhwIjoyMDk5NDg0MjUzfQ.1Ts4u4EkJmVAudeE97TioarqIW3bYSNlg03HjxJUUig

# Bus Assignment — this Pi is permanently assigned to bus 001
BUS_NUMBER=1

# Hardware Configuration
ENABLE_SMS=false
ENABLE_GPS=true
ENABLE_EMERGENCY_BUTTON=false
ENABLE_GEOLOCATION=false

# Server Configuration
SERVER_PORT=8000

SIM900A_PORT=/dev/ttyS0
SIM900A_BAUDRATE=9600

NEO6M_PORT=/dev/serial0
NEO6M_BAUDRATE=9600

EMERGENCY_BUTTON_PIN=18

OSM_USER_AGENT=BusMonitoringSystem

EMERGENCY_CONTACTS=
ADMIN_CONTACTS=

# Camera / Streaming - Ultra-low latency configuration
ENABLE_CAMERA=false
CAMERA_ID=0
CAMERA_WIDTH=480    # Camera-adjusted resolution (was 320, camera supports 480x360)
CAMERA_HEIGHT=360   # Camera-adjusted resolution (was 240, camera supports 480x360)
FPS=30             # High frame rate for smoothness
JPEG_QUALITY=25    # Very low quality for fastest encoding

# Ultra-low latency optimization settings
ENABLE_REALTIME_MODE=true    # Enable real-time optimizations
SKIP_DETECTION_FRAMES=5      # Skip more frames for faster processing
FRAME_QUEUE_SIZE=1            # Minimal queue (drop frames immediately)
DISABLE_DRAWING=false         # Enable drawing to show detection labels
DISABLE_DB_WRITES=true        # Disable database writes during streaming
SKIP_WEBSOCKET_THROTTLE=true  # Disable WebSocket throttling

# Video Recording Configuration
ENABLE_VIDEO_RECORDING=false  # Disable recording during streaming for max speed
VIDEO_STORAGE_PATH=./recordings
MAX_VIDEO_DURATION=300
VIDEO_FORMAT=mp4
VIDEO_BITRATE=1000000

# COUNT_METHOD controls how passengers are counted:
#   hog   — OpenCV built-in person detector, detects still AND moving people, no model file (default)
#   mog2  — motion-only background subtraction, won't count still people
#   yolo  — accurate YOLO detection, requires 4GB+ RAM and yolov8n.pt downloaded
DISABLE_AI=false
COUNT_METHOD=yolo
MOG2_MIN_AREA=1500

# YOLO-specific confidence threshold for person detection
# Only count detections with confidence >= this value (0.60 recommended to reduce false positives)
YOLO_CONFIDENCE_THRESHOLD=0.60