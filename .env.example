# Raspberry Pi Configuration
# The dashboard will auto-discover the Pi's IP from the database (pi_devices table)
# No hardcoded IP needed - Pi must register its IP in the database
VITE_RASPBERRY_PI_URL=https://your-pi-tunnel-url.trycloudflare.com

# Backend URL Configuration
# Production: Use Render deployment
# Development: Use Cloudflare Tunnel for local backend with remote access
# Examples:
#   Production: VITE_BACKEND_URL=https://sys-admin-my13.onrender.com
#   Development: VITE_BACKEND_URL=https://your-tunnel-url.trycloudflare.com
VITE_BACKEND_URL=https://sys-admin-my13.onrender.com

# Legacy Video Server Configuration (deprecated - use VITE_RASPBERRY_PI_URL instead)
VITE_VIDEO_SERVER_URL=ws://localhost:5000/ws

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
