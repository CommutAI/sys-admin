# Raspberry Pi Configuration
# The dashboard will auto-discover the Pi's IP from the database (pi_devices table)
# No hardcoded IP needed - Pi must register its IP in the database
VITE_RASPBERRY_PI_URL=

# Optional central video-processing backend. Leave blank to use the Pi's
# independent camera stream directly (recommended when the Pi is on the LAN).
# Example: VITE_BACKEND_URL=http://192.168.1.10:8000
VITE_BACKEND_URL=

# Legacy Video Server Configuration (deprecated - use VITE_RASPBERRY_PI_URL instead)
VITE_VIDEO_SERVER_URL=ws://localhost:5000/ws

